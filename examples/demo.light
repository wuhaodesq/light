fn main() {
    /* Demo with all v0.2.0 features:
       - Multi-line comments
       - For loops
       - Arrays */
    let numbers = [1, 2, 3, 4, 5]
    print("=== Arrays ===")
    print("First element: " + numbers[0])

    print("=== For Loop ===")
    let sum = 0
    for (let i = 0; i < 5; i + 1) {
        sum = sum + numbers[i]
        i = i + 1
    }
    print("Sum of array: " + sum)

    /* Multi-line
       comment test */
    print("=== Demo Complete ===")
}
